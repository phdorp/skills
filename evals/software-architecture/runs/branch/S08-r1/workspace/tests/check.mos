// Run from the project root: omc tests/check.mos
// Fails the run (exit 1) on any model error or when the room does not settle at the
// analytic steady state after 24 h: (k*T_set + G*T_amb)/(k + G) = 286.137 K.
// The simulation is built in the temp directory, so no build files land in the project.
loadFile("HeatingLib/package.mo");
loadFile("tests/SteadyStateTest.mo");
checkModel(HeatingLib.System);
checkModel(HeatingLib.Room);
checkModel(HeatingLib.Thermostat);
failed := getErrorString() <> "";
cd(getTempDirectoryPath());
simulate(SteadyStateTest, stopTime=86400);
T_end := val(system.room.T, 86400);
// Written as "not within" so that a failed simulation (NaN) also fails the check.
if not (abs(T_end - 286.137) <= 0.01) then failed := true; end if;
if failed then
  print("CHECK FAILED: room.T after 24 h = " + String(T_end) + " K\n");
  exit(1);
end if;
print("CHECK PASSED: room.T after 24 h = " + String(T_end) + " K\n");
